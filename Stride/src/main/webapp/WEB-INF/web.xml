<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Stride</display-name>

    <!-- Builds the database, data-access classes and services once, at start-up. -->
    <listener>
        <listener-class>com.stride.config.AppListener</listener-class>
    </listener>

    <!-- Filters run in this order on every request. -->
    <!-- 1. Security headers on every response. -->
    <filter>
        <filter-name>SecurityHeadersFilter</filter-name>
        <filter-class>com.stride.filter.SecurityHeadersFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SecurityHeadersFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 2. One guard in front of every page (sign-in, single sign-on and /assets are let through inside). -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.stride.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 3. Every POST must carry the session's anti-CSRF token. -->
    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>com.stride.filter.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 4. Role rules: /admin, /lecturer, /reports and the student-only pages. -->
    <filter>
        <filter-name>AuthorizationFilter</filter-name>
        <filter-class>com.stride.filter.AuthorizationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthorizationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <!-- The Secure flag is set at start-up from security.cookie.secure in stride.properties (D7). -->
            <attribute>
                <attribute-name>SameSite</attribute-name>
                <attribute-value>Lax</attribute-value>
            </attribute>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Views must stay free of Java code: all logic belongs in controllers.
         (trim-directive-whitespaces is deliberately off: it removed spaces between tags, defect D1.) -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <scripting-invalid>true</scripting-invalid>
        </jsp-property-group>
    </jsp-config>

    <welcome-file-list>
        <welcome-file>dashboard</welcome-file>
    </welcome-file-list>

    <!-- Friendly error pages: no stack traces or server details reach the browser (RQ14). -->
    <error-page>
        <error-code>400</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>405</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
</web-app>
